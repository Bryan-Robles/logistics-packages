# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL (docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=logistics-packages

# JWT (generate your own: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Google Maps Geocoding (optional; manual coordinates work without it)
GOOGLE_MAPS_API_KEY=

# SMTP for notifications (optional; Gmail app password)
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
